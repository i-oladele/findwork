# Copy to .env.local and fill in from your Supabase project:
#   Dashboard -> Project Settings -> API
#
# Only the anon/publishable key belongs here. It is safe in the client because
# Row Level Security governs what it can reach. NEVER put the service_role key
# in this file or anywhere under src/ — it bypasses RLS entirely.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Social sign-in buttons to show, comma separated: google, apple.
# A provider must ALSO be enabled in the Supabase dashboard with credentials
# from Google or Apple — otherwise tapping the button only produces
# "provider is not enabled". Leave blank to show no social buttons.
VITE_OAUTH_PROVIDERS=
