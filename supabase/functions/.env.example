# Secrets for the Edge Functions. For a hosted project set them with:
#   supabase secrets set PAYSTACK_SECRET_KEY=sk_test_... APP_URL=https://your-app-url
# For `supabase functions serve`, copy this file to supabase/functions/.env
#
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are provided
# automatically by the Supabase runtime; do not set them here.

# Paystack Dashboard -> Settings -> API Keys & Webhooks. Use the TEST secret
# key (sk_test_...) until you are ready to take real money.
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Where Paystack sends the user back after paying, without a trailing slash.
APP_URL=http://localhost:5173
